- name: taps
  id: epy_module
  parameters:
    alias: ''
    comment: 'Python Module: correlator / RRC taps'
    source_code: |
      """
      Taps for the DMR Decoder hier block (Python Module block).

      corr_taps(word): matched filter for one 48-bit sync word. The 24 sync symbols (+-3 levels)
        are made zero-mean and unit-energy, placed every `sps` samples and time-reversed, so the
        stock FIR Filter output at sample n is the correlation of the template with the 24
        symbol-spaced samples ENDING at n. Zero mean makes it blind to DC (carrier offset).
      ones_taps(): the same comb with all ones: FIR(x) = sum of the 24 samples, FIR(x^2) = their
        energy; together they give the window's standard deviation for normalising.
      rrc_taps(): root-raised-cosine (alpha 0.2), the matched filter for DMR's transmit filter,
        scaled to unity DC gain so the symbol levels stay at +-1 / +-3.
      """
      import numpy as np
      from gnuradio.filter import firdes

      SPS = 10
      LEVEL = [1.0, 3.0, -1.0, -3.0]                   # dibit 00, 01, 10, 11
      SYNC_BS, SYNC_MS, SYNC_DM1, SYNC_DM2 = 0x755FD7DF75F7, 0x7F7D5DD57DFD, 0x5D577F7757FF, 0x7DFFD5F55D5F


      def _comb(values, sps=SPS):
          L = 23 * sps + 1
          h = np.zeros(L)
          for i, v in enumerate(values):
              h[(L - 1) - i * sps] = v
          return h.tolist()


      def corr_taps(word, sps=SPS):
          t = np.array([LEVEL[(word >> (46 - 2 * i)) & 3] for i in range(24)])
          t = t - t.mean()
          return _comb(t / np.sqrt(np.sum(t * t)), sps)


      def ones_taps(sps=SPS):
          return _comb(np.ones(24), sps)


      def rrc_taps(sps=SPS, fs=48000.0):
          h = firdes.root_raised_cosine(1.0, fs, fs / sps, 0.2, 11 * sps + 1)
          return [t / sum(h) for t in h]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1380
    - 108
    rotation: 0
    state: enabled
