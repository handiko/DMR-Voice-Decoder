options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: DMR Tier II/III RX, RTL-SDR, stock front end + 1 EPB burst decoder
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: dmr_rx_hier
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: DMR RX (hier decoder) - RTL-SDR
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: audio_slot
  id: variable_qtgui_chooser
  parameters:
    comment: Which time slot to play. Encrypted calls are always muted.
    gui_hint: 3,1,1,1
    label: Play slot
    label0: Both slots
    label1: TS1
    label2: TS2
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '3'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1448, 408.0]
    rotation: 0
    state: enabled
- name: ch_cut
  id: variable
  parameters:
    comment: 'Channel LPF cutoff [Hz] (-6 dB). 5 kHz won the simulation;

      4.5 kHz is ~0.5 dB better once ppm is right'
    value: '6000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: ch_rate
  id: variable
  parameters:
    comment: 'Stage 2: 240 -> 48 kS/s'
    value: if_rate/5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 12]
    rotation: 0
    state: enabled
- name: ch_tw
  id: variable
  parameters:
    comment: Channel LPF transition [Hz]
    value: '2500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 92]
    rotation: 0
    state: enabled
- name: decim1
  id: variable
  parameters:
    comment: 'Stage 1: 960 -> 240 kS/s'
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: dev_unit
  id: variable
  parameters:
    comment: 'DMR 4FSK: +-648 Hz / +-1944 Hz -> symbols +-1 / +-3'
    value: '648.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 92]
    rotation: 0
    state: enabled
- name: dmr_freq
  id: variable
  parameters:
    comment: DMR carrier [Hz] (the one the P25 decoder flagged as DMR)
    value: dmr_freq_entry*1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 8.0]
    rotation: 0
    state: enabled
- name: dmr_freq_entry
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: ''
    label: DMR Freq(MHz)
    type: real
    value: '429.325'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 120.0]
    rotation: 0
    state: enabled
- name: fine_hz
  id: variable_qtgui_range
  parameters:
    comment: 'Moves the channel inside the 240 kHz IF: OK for channels within +-30
      kHz.

      Decoding re-locks on the first sync after a change.'
    gui_hint: 0,2,1,1
    label: Fine tune [Hz]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-30000'
    step: '10'
    stop: '30000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 12]
    rotation: 0
    state: enabled
- name: if_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/decim1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 92]
    rotation: 0
    state: enabled
- name: lo_offset
  id: variable
  parameters:
    comment: 'LO sits this far below the channel: keeps it off

      the RTL DC spike / LO leakage'
    value: 100e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 92]
    rotation: 0
    state: enabled
- name: mbelib_path
  id: variable
  parameters:
    comment: 'AMBE+2 vocoder library for voice audio, loaded with ctypes.

      '''' = search next to this .grc and on PATH for mbe-neo.dll (mbelib-neo 2.x,

      recommended: soft decision) or mbe.dll / libmbe (classic mbelib).

      Or give a full path, e.g. r''C:\\sdr\\mbelib-neo\\bin\\mbe-neo.dll'''
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1300, 172]
    rotation: 0
    state: enabled
- name: plan_ref_hz
  id: variable
  parameters:
    comment: 'Set to 0 to disable the configured plan

      (announced Chan_Freq always wins)'
    value: 148.7215e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 92]
    rotation: 0
    state: enabled
- name: plan_ref_lpcn
  id: variable
  parameters:
    comment: 'Channel plan (optional): LPCN n = plan_ref_hz + (n - plan_ref_lpcn)
      * plan_step_hz.

      Inferred from two measured Tait control channels:

      LPCN 151 = 148.7215 MHz (site 15), LPCN 155 = 148.7713 MHz (site 16).'
    value: '151'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 12]
    rotation: 0
    state: enabled
- name: plan_step_hz
  id: variable
  parameters:
    comment: 'Measured: 4 LPCN steps = 49.8 kHz'
    value: '12500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 172]
    rotation: 0
    state: enabled
- name: ppm
  id: variable_qtgui_range
  parameters:
    comment: 'Your gqrx shows 9-10 ppm: same driver call, same value'
    gui_hint: 0,1,1,1
    label: Freq corr [ppm]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-60'
    step: '1'
    stop: '60'
    value: '35'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1180, 12]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: Back off if the waterfall shows images / a raised floor
    gui_hint: 0,0,1,1
    label: RF gain [dB]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '29.7'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'RTL rate. 960 kS/s = 4800 x 200: integer chain 4 x 5 x 10 sps'
    value: 960e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: 10 samples per symbol (4800 Bd)
    value: int(round(ch_rate/4800))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 92]
    rotation: 0
    state: enabled
- name: volume
  id: variable_qtgui_range
  parameters:
    comment: Audio gain after the vocoder (decoder output is ~+-1 full scale)
    gui_hint: 3,0,1,1
    label: Volume
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '8'
    value: '1.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1584, 420.0]
    rotation: 0
    state: enabled
- name: audio_out
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: 'Default sound device. Occasional "aU"/"aO" on the console = sound card

      and RTL clocks differ slightly; harmless.'
    device_name: ''''''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1544, 328.0]
    rotation: 0
    state: enabled
- name: chan_lpf
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Stage 2: channel filter, /5 -> 48 kS/s'
    cutoff_freq: ch_cut
    decim: '5'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: if_rate
    type: fir_filter_ccf
    width: ch_tw
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 272.0]
    rotation: 0
    state: enabled
- name: dmr_decoder_0
  id: dmr_decoder
  parameters:
    affinity: ''
    alias: ''
    audio_delay: '0.4'
    audio_slot: audio_slot
    color_code: '-1'
    comment: 'Hier block (open dmr_decoder_hier.grc to see inside):

      matched filter -> sync correlators -> burst framer EPB

      -> Layer 2 EPB -> AMBE+2 vocoder EPB'
    dedup_s: '10.0'
    maxoutbuf: '0'
    mbelib_path: mbelib_path
    minoutbuf: '0'
    plan_ref_hz: plan_ref_hz
    plan_ref_lpcn: plan_ref_lpcn
    plan_step_hz: plan_step_hz
    rf_hz: dmr_freq + fine_hz
    stats_every: '10.0'
    sync_thresh: '0.8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 232.0]
    rotation: 0
    state: enabled
- name: fft_if
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
