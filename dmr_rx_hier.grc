    xmax: '6'
    xmin: '-6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1232, 400.0]
    rotation: 0
    state: enabled
- name: quad_demod
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: 'FM discriminator: 600 Hz -> 1.0'
    gain: ch_rate/(2*3.141592653589793*dev_unit)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 312.0]
    rotation: 0
